# Copy values into a local .env that is excluded from source control.
AIOPS_DB_NAME=aiops
AIOPS_DATASOURCE_USERNAME=raguser
AIOPS_DATASOURCE_PASSWORD=
AIOPS_LOCAL_MASTER_KEY=
AIOPS_AI_BASE_URL=http://host.docker.internal:11434
AIOPS_AI_MODEL=qwen2.5-coder:7b
AIOPS_AI_CHAT_HEARTBEAT_MS=15000
AIOPS_AI_STREAM_TIMEOUT_MS=330000
AIOPS_KUBERNETES_CONNECT_TIMEOUT_MS=5000
AIOPS_KUBERNETES_REQUEST_TIMEOUT_MS=10000
AIOPS_ANALYSIS_LOG_TAIL_LINES=80
AIOPS_ANALYSIS_MAX_LOG_CHARS=4000
AIOPS_ANALYSIS_MAX_LOG_PODS=20
AIOPS_ANALYSIS_MAX_COLLECTION_FAILURES=6
AIOPS_CLUSTER_LOG_HEARTBEAT_MS=15000
AIOPS_CLUSTER_LOG_MAX_STREAM_DURATION_MS=1800000
AIOPS_CLUSTER_LOG_MAX_TARGET_PODS=50
# Kubernetes console worker, recovery, and distributed admission limits.
AIOPS_COMMAND_TIMEOUT_SECONDS=60
AIOPS_COMMAND_STREAM_TIMEOUT_SECONDS=900
AIOPS_TERMINAL_IDLE_SECONDS=900
AIOPS_COMMAND_MAXIMUM_OUTPUT_BYTES=1048576
AIOPS_COMMAND_RECOVERY_MINIMUM_AGE_SECONDS=90
AIOPS_COMMAND_RECOVERY_INTERVAL_MS=30000
AIOPS_COMMAND_USER_CONCURRENCY=5
AIOPS_TERMINAL_USER_CONCURRENCY=3
AIOPS_COMMAND_CLUSTER_CONCURRENCY=50
AIOPS_TERMINAL_CLUSTER_CONCURRENCY=20
AIOPS_COMMAND_USER_STARTS_PER_MINUTE=30
AIOPS_COMMAND_CLUSTER_STARTS_PER_MINUTE=120
# Use remote in packaged Kubernetes deployments. Local is intended only for isolated development.
AIOPS_COMMAND_RUNNER_MODE=local
AIOPS_COMMAND_RUNNER_URL=http://127.0.0.1:8090
AIOPS_COMMAND_RUNNER_TOKEN=
AIOPS_COMMAND_VERIFICATION_TIMEOUT_SECONDS=15
AIOPS_COMPOSE_DB_PORT=15432
AIOPS_BACKEND_PORT=8080
AIOPS_FRONTEND_PORT=8088
# OIDC is the default local and production authentication path. Use local only in isolated tests.
AIOPS_BACKEND_PROFILES=postgres,security-oidc
AIOPS_OIDC_ISSUER_URI=
AIOPS_OIDC_CLIENT_ID=
AIOPS_OIDC_CLIENT_SECRET=
AIOPS_OIDC_GROUPS_CLAIM=groups
AIOPS_SESSION_COOKIE_SECURE=true
AIOPS_SESSION_TIMEOUT=30m
AIOPS_SESSION_ABSOLUTE_TIMEOUT=8h
# Optional local OIDC compatibility environment. Never reuse these development secrets in production.
AIOPS_KEYCLOAK_PORT=18080
AIOPS_KEYCLOAK_ADMIN=admin
AIOPS_KEYCLOAK_ADMIN_PASSWORD=
# Kubernetes managed identity uses pre-created Secret names in Helm values.
AIOPS_MANAGED_KEYCLOAK_NAMESPACE=aiops-system
AIOPS_MANAGED_KEYCLOAK_RELEASE=aiops
AIOPS_INITIAL_ADMIN_USERNAME=platform-admin
AIOPS_INITIAL_ADMIN_PASSWORD=

# Public endpoint contract. AIOPS_PUBLIC_HOST is a local/LAN convenience;
# production must provide the two explicit HTTPS URLs below.
AIOPS_PUBLIC_HOST=127.0.0.1
AIOPS_PORTAL_PUBLIC_URL=http://127.0.0.1:30081
AIOPS_OIDC_PUBLIC_ISSUER=http://auth.aiops.local:30080/realms/aiops
AIOPS_ADDITIONAL_PORTAL_URLS=http://127.0.0.1:5173
AIOPS_PRODUCTION_MODE=false

# Production evidence inputs. Tokens/cookies stay outside committed files.
AIOPS_EVIDENCE_ENVIRONMENT=customer-staging
AIOPS_EVIDENCE_DIR=artifacts/production-evidence
AIOPS_ANALYSIS_SOAK_CLUSTER_ID=
AIOPS_ANALYSIS_SOAK_NAMESPACE=default
AIOPS_ANALYSIS_SOAK_RUNS=10
AIOPS_ANALYSIS_SOAK_MIN_SUCCESS_RATIO=0.95
AIOPS_ANALYSIS_SOAK_MAX_FALLBACK_RATIO=0.10
AIOPS_ROLLBACK_REHEARSAL_ENABLED=false
